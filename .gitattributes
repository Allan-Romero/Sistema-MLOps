# Los archivos que se ejecutan dentro de contenedores Linux conservan LF:
# con CRLF el shell del contenedor falla al interpretar los comandos.
*.Dockerfile text eol=lf
Dockerfile    text eol=lf
*.sh          text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
docker/requirements-*.txt text eol=lf
