# Variables de entorno de la plataforma MLOps
# Copia este archivo como .env y reemplaza los valores segun tu configuracion local
# Comando: cp .env.example .env

# Credenciales de PostgreSQL
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_DB=mlops_db

# Host y puerto de PostgreSQL.
# No es necesario definirlos: por defecto se usa localhost:5432 y dentro de
# docker compose cada servicio recibe POSTGRES_HOST=postgres automaticamente.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# URL del servidor de MLflow (en docker compose se usa http://mlflow:5000)
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# URL base de la API para el script de generacion de trafico
# API_URL=http://localhost:8000
